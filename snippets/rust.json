{
  "Initialize an immutable vec": {
    "prefix": "let-vec",
    "description": "Initialize an empty immutable empty vec",
    "body": ["let ${1:vec} = vec![$2];"]
  },
  "Initialize a mutable vec": {
    "prefix": "mut-vec",
    "description": "Initialize an empty mutable empty vec",
    "body": ["let mut ${1:vec} = vec![$2];"]
  },
  "Match an option": {
    "prefix": "match-option",
    "description": "Match an option statement",
    "body": [
      "match ${1:option} {",
      "  Some(value) => { $2 }",
      "  None => { $3 }",
      "}"
    ]
  },
  "Match a result": {
    "prefix": "match-result",
    "description": "Match a result statement",
    "body": [
      "match ${1:result} {",
      "  Ok(value) => { $2 }",
      "  Err(error) => { $3 }",
      "}"
    ]
  },
  "If let some": {
    "prefix": "if-some",
    "description": "If let Some pattern matching",
    "body": ["if let Some(${1:value}) = ${2:option} {", "  $3", "}"]
  },
  "Clone struct": {
    "prefix": "clone-struct",
    "description": "Clone a struct",
    "body": [
      "#[derive(Clone)]",
      "struct ${1:Name} {",
      "  ${2:field}: ${3:Type},",
      "}"
    ]
  },
  "Debug struct": {
    "prefix": "debug-struct",
    "description": "Debug struct",
    "body": [
      "#[derive(Debug)]",
      "struct ${1:Name} {",
      "  ${2:field}: ${3:Type},",
      "}"
    ]
  },
  "Clone and debug struct": {
    "prefix": "clone-debug-struct",
    "description": "Clone and debug struct",
    "body": [
      "#[derive(Clone, Debug)]",
      "struct ${1:Name} {",
      "  ${2:field}: ${3:Type},",
      "}"
    ]
  },
  "Windows only derive": {
    "prefix": "win-only",
    "description": "A Windows only derive",
    "body": ["#[cfg(target_os = \"windows\")]"]
  },
  "MacOS only derive": {
    "prefix": "mac-only",
    "description": "A MacOS only derive",
    "body": ["#[cfg(target_os = \"macos\")]"]
  },
  "Linux only derive": {
    "prefix": "linux-only",
    "description": "A Linux only derive",
    "body": ["#[cfg(target_os = \"linux\")]"]
  },
  "iOS only derive": {
    "prefix": "ios-only",
    "description": "An iOS only derive",
    "body": ["#[cfg(target_os = \"ios\")]"]
  },
  "Android only derive": {
    "prefix": "android-only",
    "description": "An Android only derive",
    "body": ["#[cfg(target_os = \"android\")]"]
  },
  "If let ok": {
    "prefix": "if-ok",
    "description": "If let Ok pattern matching",
    "body": ["if let Ok(${1:value}) = ${2:result} {", "  $3", "}"]
  },
  "Let else": {
    "prefix": "let-else",
    "description": "Let else binding with early return",
    "body": ["let ${1:Some(value)} = ${2:expr} else {", "  ${3:return};", "};"]
  },
  "While let some": {
    "prefix": "while-some",
    "description": "While let Some loop",
    "body": ["while let Some(${1:value}) = ${2:iter}.next() {", "  $3", "}"]
  },
  "For loop": {
    "prefix": "for-in",
    "description": "For loop over an iterator",
    "body": ["for ${1:item} in ${2:iter} {", "  $3", "}"]
  },
  "Function": {
    "prefix": "fn",
    "description": "A function",
    "body": ["fn ${1:name}($2)${3: -> $4} {", "  $5", "}"]
  },
  "Async function": {
    "prefix": "async-fn",
    "description": "An async function",
    "body": ["async fn ${1:name}($2)${3: -> $4} {", "  $5", "}"]
  },
  "Public function": {
    "prefix": "pub-fn",
    "description": "A public function",
    "body": ["pub fn ${1:name}($2)${3: -> $4} {", "  $5", "}"]
  },
  "Public async function": {
    "prefix": "pub-async-fn",
    "description": "A public async function",
    "body": ["pub async fn ${1:name}($2)${3: -> $4} {", "  $5", "}"]
  },
  "Implementation block": {
    "prefix": "impl",
    "description": "An impl block",
    "body": ["impl ${1:Type} {", "  $2", "}"]
  },
  "Trait implementation block": {
    "prefix": "impl-trait",
    "description": "Implement a trait for a type",
    "body": ["impl ${1:Trait} for ${2:Type} {", "  $3", "}"]
  },
  "New constructor": {
    "prefix": "fn-new",
    "description": "A new() constructor",
    "body": ["pub fn new($1) -> Self {", "  Self { $2 }", "}"]
  },
  "Default implementation": {
    "prefix": "impl-default",
    "description": "Implement Default for a type",
    "body": [
      "impl Default for ${1:Type} {",
      "  fn default() -> Self {",
      "    Self { $2 }",
      "  }",
      "}"
    ]
  },
  "Display implementation": {
    "prefix": "impl-display",
    "description": "Implement Display for a type",
    "body": [
      "impl std::fmt::Display for ${1:Type} {",
      "  fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {",
      "    write!(f, \"${2:{}}\", $3)",
      "  }",
      "}"
    ]
  },
  "From implementation": {
    "prefix": "impl-from",
    "description": "Implement From for a type",
    "body": [
      "impl From<${1:Source}> for ${2:Target} {",
      "  fn from(${3:value}: ${1:Source}) -> Self {",
      "    $4",
      "  }",
      "}"
    ]
  },
  "Trait": {
    "prefix": "trait",
    "description": "A trait definition",
    "body": ["trait ${1:Name} {", "  $2", "}"]
  },
  "Enum": {
    "prefix": "enum",
    "description": "An enum definition",
    "body": [
      "#[derive(Clone, Debug)]",
      "enum ${1:Name} {",
      "  ${2:Variant},",
      "}"
    ]
  },
  "Match": {
    "prefix": "match",
    "description": "A match statement",
    "body": ["match ${1:value} {", "  ${2:pattern} => $3,", "  _ => $4,", "}"]
  },
  "Test function": {
    "prefix": "test",
    "description": "A test function",
    "body": ["#[test]", "fn ${1:name}() {", "  $2", "}"]
  },
  "Test module": {
    "prefix": "test-mod",
    "description": "A tests module",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "  use super::*;",
      "",
      "  #[test]",
      "  fn ${1:name}() {",
      "    $2",
      "  }",
      "}"
    ]
  },
  "Main function": {
    "prefix": "main",
    "description": "The main function",
    "body": ["fn main() {", "  $1", "}"]
  },
  "Serde struct": {
    "prefix": "serde-struct",
    "description": "A serializable and deserializable struct",
    "body": [
      "#[derive(Serialize, Deserialize)]",
      "struct ${1:Name} {",
      "  ${2:field}: ${3:Type},",
      "}"
    ]
  },
  "Derive all": {
    "prefix": "derive-all",
    "description": "Derive the common traits",
    "body": ["#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]"]
  },
  "Hash map": {
    "prefix": "hash-map",
    "description": "Initialize a mutable HashMap",
    "body": ["let mut ${1:map} = std::collections::HashMap::new();"]
  },
  "Hash set": {
    "prefix": "hash-set",
    "description": "Initialize a mutable HashSet",
    "body": ["let mut ${1:set} = std::collections::HashSet::new();"]
  },
  "Unsafe block": {
    "prefix": "unsafe",
    "description": "An unsafe block",
    "body": ["unsafe {", "  $1", "}"]
  },
  "Allow lint": {
    "prefix": "allow",
    "description": "Allow a lint",
    "body": ["#[allow(${1:dead_code})]"]
  }
}
